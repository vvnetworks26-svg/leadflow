# LeadFlow Marketing — Environment Variables
# Copy this file to .env and fill in your values.

# Public API URL (used by the contact form widget client)
VITE_API_URL=http://localhost:4000

# Widget token — org slug for the public chat widget on the marketing site
VITE_WIDGET_TOKEN=

# URL of the dashboard app — used for Sign In / Sign Up / Try Free links
VITE_DASHBOARD_URL=http://localhost:3000
