# ─────────────────────────────────────────────────────────────────
# LeadFlow API — Environment Variables
# Copy this file to .env and fill in all values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
API_VERSION=1.0.0

# Database — required in production
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/leadflow?retryWrites=true&w=majority

# Redis — required in production. Backs the BullMQ async pipeline
# (ai/pipeline/) that generates conversation summaries after a conversation
# ends. LOCAL DEV NEEDS A REAL REDIS INSTANCE RUNNING — the default below
# only works if one is up, e.g.:
#   brew install redis && brew services start redis
#   # or: docker run -d -p 6379:6379 redis
# Without Redis running, the API will still start (queue/worker start
# failures are logged, not fatal), but conversation summaries will never
# be generated.
REDIS_URL=redis://localhost:6379

# JWT — required in production (use long random strings, minimum 32 chars)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# AI — Gemini API key (optional; AI uses rule-based fallbacks if absent)
GEMINI_API_KEY=
# Gemini model ID. Verified live against https://ai.google.dev/gemini-api/docs/models
# as of 2026-08 — model IDs in this ecosystem churn every few months, re-check
# before assuming this is still current. Server logs an ERROR at boot (and per-turn
# falls back to the rule-based planner) if this model is no longer reachable.
GEMINI_MODEL=gemini-3.6-flash

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/calendar/oauth/google/callback

# Microsoft 365 OAuth (optional)
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Communications providers (optional)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
META_WA_PHONE_ID=
META_WA_TOKEN=

# AI embeddings (optional — falls back to local deterministic mock if absent)
OPENAI_API_KEY=

# Logging
LOG_LEVEL=info
