{
  "name": "leadflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm":  ">=10.0.0"
  },
  "workspaces": [
    "apps/dashboard",
    "apps/marketing",
    "apps/widget",
    "apps/api",
    "apps/docs",
    "packages/types",
    "packages/shared",
    "packages/widget-sdk"
  ],
  "scripts": {
    "dev":               "npm run dev --workspace=apps/dashboard",
    "build":             "npm run build --workspace=apps/dashboard",
    "preview":           "npm run preview --workspace=apps/dashboard",
    "dev:marketing":     "npm run dev --workspace=apps/marketing",
    "build:marketing":   "npm run build --workspace=apps/marketing",
    "dev:widget":        "npm run dev --workspace=apps/widget",
    "build:widget-app":  "npm run build --workspace=apps/widget",
    "dev:api":           "npm run dev --workspace=apps/api",
    "build:api":         "npm run build --workspace=apps/api",
    "build:widget-sdk":  "npm run build --workspace=packages/widget-sdk",
    "build:all":         "npm run build --workspaces --if-present",
    "lint":              "npm run lint --workspaces --if-present",
    "clean":             "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  },
  "overrides": {
    "rollup": "4.62.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu":  "4.62.2",
    "@rollup/rollup-linux-x64-musl": "4.62.2",
    "@rollup/rollup-linux-arm64-gnu":  "4.62.2",
    "@rollup/rollup-linux-arm64-musl": "4.62.2",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "lightningcss-linux-arm64-musl": "1.32.0"
  }
}
