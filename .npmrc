# Ensure optional native dependencies (Rollup, LightningCSS, esbuild platform binaries)
# are always installed regardless of the current OS/CPU.
# This is required for CI and Vercel (Linux x64) deployments when the lockfile
# was generated on macOS (darwin-arm64).

# Force installation of optional dependencies (includes platform-specific binaries)
# Using --omit=optional would exclude them, so we ensure they are included by default
install-strategy=hoisted
